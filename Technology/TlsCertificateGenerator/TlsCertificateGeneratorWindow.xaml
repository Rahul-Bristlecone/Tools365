<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Tools365.Technology.TlsCertificateGenerator.TlsCertificateGeneratorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TLS certificate generator">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <ScrollViewer>
        <Grid Padding="24" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="4">
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="TLS certificate generator" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Create a self-signed server certificate and an AES-256 encrypted PEM private key."
                    TextWrapping="Wrap" />
            </StackPanel>
            <InfoBar
                Grid.Row="1"
                IsClosable="False"
                IsOpen="True"
                Severity="Warning"
                Title="Self-signed certificate"
                Message="Browsers and clients will not trust this certificate by default. Keep the private-key password and generated key secret." />
            <Border
                Grid.Row="2"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Primary DNS name" />
                        <TextBox
                            x:Name="PrimaryNameBox"
                            PlaceholderText="e.g. api.example.com"
                            AutomationProperties.Name="Primary certificate DNS name" />
                    </StackPanel>
                    <StackPanel
                        Grid.Row="1"
                        Spacing="6">
                        <TextBlock Text="Additional DNS names or IP addresses (comma-separated, optional)" />
                        <TextBox
                            x:Name="AdditionalNamesBox"
                            PlaceholderText="e.g. www.example.com, 127.0.0.1"
                            AutomationProperties.Name="Additional certificate names" />
                    </StackPanel>
                    <Grid
                        Grid.Row="2"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Validity (days, max 397)" />
                            <NumberBox
                                x:Name="ValidityDaysBox"
                                Value="90"
                                Minimum="1"
                                Maximum="397"
                                SpinButtonPlacementMode="Compact"
                                AutomationProperties.Name="Certificate validity in days" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            Spacing="6">
                            <TextBlock Text="Private-key password (12+ characters)" />
                            <PasswordBox
                                x:Name="KeyPasswordBox"
                                PasswordRevealMode="Peek"
                                AutomationProperties.Name="Private key encryption password" />
                        </StackPanel>
                    </Grid>
                    <Button
                        Grid.Row="3"
                        HorizontalAlignment="Left"
                        Click="GenerateButton_Click"
                        Content="Generate certificate" />
                    <InfoBar
                        x:Name="ValidationBar"
                        Grid.Row="4"
                        IsClosable="False"
                        IsOpen="False"
                        Severity="Warning" />
                </Grid>
            </Border>
            <Grid
                Grid.Row="3"
                ColumnSpacing="12"
                RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border
                    Padding="14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock FontWeight="SemiBold" Text="CERTIFICATE (PEM)" />
                        <TextBox
                            x:Name="CertificateOutputBox"
                            Grid.Row="1"
                            AcceptsReturn="True"
                            FontFamily="Cascadia Mono"
                            IsReadOnly="True"
                            IsSpellCheckEnabled="False"
                            MinHeight="220"
                            TextWrapping="NoWrap"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            AutomationProperties.Name="Generated certificate PEM" />
                        <Button
                            x:Name="CopyCertificateButton"
                            Grid.Row="2"
                            HorizontalAlignment="Left"
                            Click="CopyCertificateButton_Click"
                            Content="Copy certificate"
                            IsEnabled="False" />
                    </Grid>
                </Border>
                <Border
                    Grid.Column="1"
                    Padding="14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock FontWeight="SemiBold" Text="ENCRYPTED PRIVATE KEY (PEM)" />
                        <TextBox
                            x:Name="PrivateKeyOutputBox"
                            Grid.Row="1"
                            AcceptsReturn="True"
                            FontFamily="Cascadia Mono"
                            IsReadOnly="True"
                            IsSpellCheckEnabled="False"
                            MinHeight="220"
                            TextWrapping="NoWrap"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            AutomationProperties.Name="Generated encrypted private key PEM" />
                        <Button
                            x:Name="CopyPrivateKeyButton"
                            Grid.Row="2"
                            HorizontalAlignment="Left"
                            Click="CopyPrivateKeyButton_Click"
                            Content="Copy private key"
                            IsEnabled="False" />
                    </Grid>
                </Border>
                <TextBlock
                    x:Name="ExpiryText"
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
