<?xml version="1.0" encoding="utf-8" ?>
<Window x:Class="Tools365.Technology.KubernetesResourceCalculatorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Kubernetes Capacity Planner"  >
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <ScrollViewer >
        <Grid Padding="28" RowSpacing="18" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.ColumnSpan="2" Spacing="4">
                <TextBlock FontSize="26" FontWeight="SemiBold" Text="Kubernetes Capacity Planner" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Decide whether to scale pods horizontally or make pods and nodes larger." TextWrapping="Wrap" />
            </StackPanel>

            <InfoBar x:Name="ValidationBar" Grid.Row="1" Grid.ColumnSpan="2" IsOpen="False" IsClosable="False" Severity="Warning" />

            <StackPanel Grid.Row="2" Spacing="14">
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="CloudWatch workload metrics" />
                <StackPanel Spacing="6">
                    <TextBlock Text="Current pods" />
                    <NumberBox x:Name="CurrentPodsBox" Value="4" Minimum="1" SpinButtonPlacementMode="Compact" />
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="CPU request per pod (millicores)" />
                    <NumberBox x:Name="CpuRequestBox" Value="500" Minimum="1" SpinButtonPlacementMode="Compact" />
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="CPU usage per pod (millicores)" />
                    <NumberBox x:Name="CpuUsageBox" Value="450" Minimum="0" SpinButtonPlacementMode="Compact" />
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="Memory request per pod (MiB)" />
                    <NumberBox x:Name="MemoryRequestBox" Value="1024" Minimum="1" SpinButtonPlacementMode="Compact" />
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="Memory usage per pod (MiB)" />
                    <NumberBox x:Name="MemoryUsageBox" Value="600" Minimum="0" SpinButtonPlacementMode="Compact" />
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="Current requests per second" />
                    <NumberBox x:Name="CurrentRpsBox" Value="800" Minimum="1" SpinButtonPlacementMode="Compact" />
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="Peak requests per second" />
                    <NumberBox x:Name="PeakRpsBox" Value="2000" Minimum="1" SpinButtonPlacementMode="Compact" />
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="Target pods (optional override)" />
                    <NumberBox x:Name="TargetPodsBox" PlaceholderText="Use peak recommendation" Minimum="1" SpinButtonPlacementMode="Compact" />
                </StackPanel>
                <Button HorizontalAlignment="Left" Click="CalculateButton_Click" Content="Analyze capacity" />
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="1" Spacing="14">
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Capacity decision" />
                <Border Padding="16" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="RecommendationTitleText" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock x:Name="AnalysisText" TextWrapping="Wrap" />
                        <TextBlock x:Name="ReasonText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Padding="14" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                        <StackPanel Spacing="6">
                            <TextBlock FontWeight="SemiBold" Text="Replica plan" />
                            <TextBlock x:Name="ReplicaPlanText" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Padding="14" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                        <StackPanel Spacing="6">
                            <TextBlock FontWeight="SemiBold" Text="Node capacity" />
                            <TextBlock x:Name="NodePlanText" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Suggested pod resources" />
                <Border Padding="16" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <TextBox x:Name="YamlOutputBox" FontFamily="Cascadia Mono" IsReadOnly="True" IsSpellCheckEnabled="False" MinHeight="160" TextWrapping="NoWrap" AcceptsReturn="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </Border>
                <Button HorizontalAlignment="Left" Click="CopyYamlButton_Click" Content="Copy YAML" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
