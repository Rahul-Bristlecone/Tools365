<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Tools365.Technology.CidrCalculator.CidrCalculatorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CIDR calculator">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <ScrollViewer>
        <Grid Padding="28" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock FontSize="26" FontWeight="SemiBold" Text="CIDR calculator" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Enter an IPv4 address with its prefix length to calculate subnet details."
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="IPv4 address / prefix length" />
                <TextBox
                    x:Name="CidrInputBox"
                    PlaceholderText="192.168.1.10/24"
                    Text="192.168.1.10/24"
                    AutomationProperties.Name="IPv4 address in CIDR notation"
                    TextChanged="CidrInputBox_TextChanged" />
                <InfoBar
                    x:Name="ValidationBar"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Warning" />
            </StackPanel>

            <Border
                x:Name="ResultsPanel"
                Grid.Row="2"
                Padding="18"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="14">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Network details" />
                    <Grid ColumnSpacing="20" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Network address" />
                            <TextBlock x:Name="NetworkAddressText" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Broadcast address" />
                            <TextBlock x:Name="BroadcastAddressText" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Spacing="3">
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Subnet mask" />
                            <TextBlock x:Name="SubnetMaskText" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3">
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Wildcard mask" />
                            <TextBlock x:Name="WildcardMaskText" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Spacing="3">
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="First usable address" />
                            <TextBlock x:Name="FirstUsableAddressText" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="3">
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Last usable address" />
                            <TextBlock x:Name="LastUsableAddressText" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Spacing="3">
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Total addresses" />
                            <TextBlock x:Name="TotalAddressesText" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="1" Spacing="3">
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Usable hosts" />
                            <TextBlock x:Name="UsableHostsText" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                    <Button
                        x:Name="CopyButton"
                        HorizontalAlignment="Left"
                        Click="CopyButton_Click"
                        Content="Copy details" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
