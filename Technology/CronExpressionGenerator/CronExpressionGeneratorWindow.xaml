<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Tools365.Technology.CronExpressionGenerator.CronExpressionGeneratorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Cron expression generator">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <ScrollViewer>
        <Grid Padding="28" RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock FontSize="26" FontWeight="SemiBold" Text="Cron expression generator" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Build a standard five-field cron expression for common schedules."
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border
                Grid.Row="1"
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Schedule" />
                        <ComboBox
                            x:Name="ScheduleComboBox"
                            HorizontalAlignment="Stretch"
                            SelectedIndex="3"
                            AutomationProperties.Name="Cron schedule">
                            <ComboBoxItem Content="Every minute" />
                            <ComboBoxItem Content="Every N minutes" />
                            <ComboBoxItem Content="Hourly" />
                            <ComboBoxItem Content="Daily" />
                            <ComboBoxItem Content="Weekdays" />
                            <ComboBoxItem Content="Weekly" />
                            <ComboBoxItem Content="Monthly" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel
                        x:Name="IntervalPanel"
                        Spacing="6"
                        Visibility="Collapsed">
                        <TextBlock Text="Run every (minutes)" />
                        <NumberBox
                            x:Name="IntervalBox"
                            Value="5"
                            Minimum="1"
                            Maximum="59"
                            SpinButtonPlacementMode="Compact"
                            AutomationProperties.Name="Minute interval" />
                    </StackPanel>

                    <StackPanel
                        x:Name="TimePanel"
                        Spacing="6"
                        Visibility="Visible">
                        <TextBlock Text="Run time (24-hour clock)" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Hour (0–23)" />
                                <NumberBox
                                    x:Name="HourBox"
                                    Value="9"
                                    Minimum="0"
                                    Maximum="23"
                                    SpinButtonPlacementMode="Compact"
                                    AutomationProperties.Name="Hour" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Minute (0–59)" />
                                <NumberBox
                                    x:Name="MinuteBox"
                                    Value="0"
                                    Minimum="0"
                                    Maximum="59"
                                    SpinButtonPlacementMode="Compact"
                                    AutomationProperties.Name="Minute" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel
                        x:Name="WeekdayPanel"
                        Spacing="6"
                        Visibility="Collapsed">
                        <TextBlock Text="Day of week" />
                        <ComboBox
                            x:Name="WeekdayComboBox"
                            HorizontalAlignment="Stretch"
                            SelectedIndex="1"
                            AutomationProperties.Name="Day of week">
                            <ComboBoxItem Content="Sunday" />
                            <ComboBoxItem Content="Monday" />
                            <ComboBoxItem Content="Tuesday" />
                            <ComboBoxItem Content="Wednesday" />
                            <ComboBoxItem Content="Thursday" />
                            <ComboBoxItem Content="Friday" />
                            <ComboBoxItem Content="Saturday" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel
                        x:Name="MonthDayPanel"
                        Spacing="6"
                        Visibility="Collapsed">
                        <TextBlock Text="Day of month" />
                        <NumberBox
                            x:Name="MonthDayBox"
                            Value="1"
                            Minimum="1"
                            Maximum="31"
                            SpinButtonPlacementMode="Compact"
                            AutomationProperties.Name="Day of month" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <InfoBar
                x:Name="ValidationBar"
                Grid.Row="2"
                IsClosable="False"
                IsOpen="False"
                Severity="Warning" />

            <Border
                Grid.Row="3"
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="10">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="CRON EXPRESSION" />
                    <TextBox
                        x:Name="ExpressionTextBox"
                        FontFamily="Cascadia Mono"
                        FontSize="24"
                        IsReadOnly="True"
                        IsSpellCheckEnabled="False"
                        Text="0 9 * * *"
                        AutomationProperties.Name="Generated cron expression" />
                    <TextBlock
                        x:Name="DescriptionText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="At 09:00 every day."
                        TextWrapping="Wrap"
                        AutomationProperties.Name="Schedule description" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Fields: minute  hour  day of month  month  day of week"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Button
                x:Name="CopyButton"
                Grid.Row="4"
                HorizontalAlignment="Left"
                Click="CopyButton_Click"
                Content="Copy expression"
                IsEnabled="False"
                AutomationProperties.Name="Copy cron expression" />
        </Grid>
    </ScrollViewer>
</Window>
