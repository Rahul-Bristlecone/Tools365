<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Tools365.Technology.YamlJsonConverter.YamlJsonConverterWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="YAML / JSON converter">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="YAML / JSON converter" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Convert structured data between YAML and JSON."
                TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="6">
            <TextBlock Text="Conversion direction" />
            <ComboBox
                x:Name="DirectionComboBox"
                HorizontalAlignment="Left"
                MinWidth="220"
                SelectedIndex="0"
                AutomationProperties.Name="Conversion direction">
                <ComboBoxItem Content="YAML to JSON" />
                <ComboBoxItem Content="JSON to YAML" />
            </ComboBox>
        </StackPanel>

        <InfoBar
            x:Name="ValidationBar"
            Grid.Row="2"
            IsClosable="False"
            IsOpen="False"
            Severity="Warning" />

        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Padding="14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        x:Name="SourceFormatText"
                        FontWeight="SemiBold"
                        Text="YAML INPUT" />
                    <TextBox
                        x:Name="InputTextBox"
                        Grid.Row="1"
                        AcceptsReturn="True"
                        FontFamily="Cascadia Mono"
                        IsSpellCheckEnabled="False"
                        PlaceholderText="Paste YAML here..."
                        TextWrapping="NoWrap"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        AutomationProperties.Name="Source document" />
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Padding="14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        x:Name="TargetFormatText"
                        FontWeight="SemiBold"
                        Text="JSON OUTPUT" />
                    <TextBox
                        x:Name="OutputTextBox"
                        Grid.Row="1"
                        AcceptsReturn="True"
                        FontFamily="Cascadia Mono"
                        IsReadOnly="True"
                        IsSpellCheckEnabled="False"
                        PlaceholderText="Converted output will appear here..."
                        TextWrapping="NoWrap"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        AutomationProperties.Name="Converted document" />
                </Grid>
            </Border>
        </Grid>

        <StackPanel
            Grid.Row="4"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                Click="ConvertButton_Click"
                Content="Convert"
                AutomationProperties.Name="Convert document" />
            <Button
                x:Name="CopyButton"
                Click="CopyButton_Click"
                Content="Copy output"
                IsEnabled="False"
                AutomationProperties.Name="Copy converted output" />
            <Button
                Click="ClearButton_Click"
                Content="Clear"
                AutomationProperties.Name="Clear documents" />
        </StackPanel>
    </Grid>
</Window>
