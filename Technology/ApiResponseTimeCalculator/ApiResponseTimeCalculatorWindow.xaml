<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Tools365.Technology.ApiResponseTimeCalculator.ApiResponseTimeCalculatorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="API response time calculator">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid Padding="24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="API response time calculator" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Paste response times in milliseconds, separated by spaces, commas, or new lines."
                TextWrapping="Wrap" />
        </StackPanel>
        <Border
            Grid.Row="1"
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Response-time samples (ms)" />
                <TextBox
                    x:Name="SamplesBox"
                    Grid.Row="1"
                    AcceptsReturn="True"
                    FontFamily="Cascadia Mono"
                    IsSpellCheckEnabled="False"
                    PlaceholderText="e.g. 120, 145, 98, 310, 132"
                    TextWrapping="Wrap"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    AutomationProperties.Name="Response time samples in milliseconds" />
            </Grid>
        </Border>
        <InfoBar
            x:Name="ValidationBar"
            Grid.Row="2"
            IsClosable="False"
            IsOpen="False"
            Severity="Warning" />
        <Grid Grid.Row="3" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="4">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="SAMPLES" />
                        <TextBlock x:Name="CountText" FontSize="20" FontWeight="SemiBold" Text="—" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="4">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="AVERAGE" />
                        <TextBlock x:Name="AverageText" FontSize="20" FontWeight="SemiBold" Text="—" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="4">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="MEDIAN" />
                        <TextBlock x:Name="MedianText" FontSize="20" FontWeight="SemiBold" Text="—" />
                    </StackPanel>
                </Border>
            </Grid>
            <Grid Grid.Row="1" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="4">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="MINIMUM" />
                        <TextBlock x:Name="MinimumText" FontSize="18" FontWeight="SemiBold" Text="—" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="4">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="P95 (NEAREST RANK)" />
                        <TextBlock x:Name="P95Text" FontSize="18" FontWeight="SemiBold" Text="—" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="4">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="P99 (NEAREST RANK)" />
                        <TextBlock x:Name="P99Text" FontSize="18" FontWeight="SemiBold" Text="—" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="4">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="MAXIMUM" />
                        <TextBlock x:Name="MaximumText" FontSize="18" FontWeight="SemiBold" Text="—" />
                    </StackPanel>
                </Border>
            </Grid>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                <Button Click="CalculateButton_Click" Content="Calculate" AutomationProperties.Name="Calculate response time metrics" />
                <Button Click="ClearButton_Click" Content="Clear" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
