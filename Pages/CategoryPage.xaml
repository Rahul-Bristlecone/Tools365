<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Tools365.Pages.CategoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Tools365.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="32,24" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="CategoryTitle"
            Style="{StaticResource TitleTextBlockStyle}" />

        <ItemsControl
            Grid.Row="1"
            ItemsSource="{x:Bind Cards, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid
                        HorizontalAlignment="Stretch"
                        MaximumRowsOrColumns="2"
                        Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:ToolCard">
                    <Grid Width="{x:Bind CardWidth}" Margin="0,0,16,16">
                        <Border
                            Height="148"
                            Padding="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Tapped="ToolCard_Tapped"
                            Visibility="{x:Bind local:CategoryPage.StandardCardVisibility(IsConverter, IsKubernetesCalculator), Mode=OneWay}">
                            <StackPanel Spacing="8">
                                <Grid HorizontalAlignment="Left" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Padding="8,4"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <TextBlock
                                            FontSize="20"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Title}" />
                                    </Border>
                                    <Button
                                        Grid.Column="1"
                                        Width="32"
                                        Height="32"
                                        VerticalAlignment="Center"
                                        Padding="0"
                                        Click="InfoButton_Click"
                                        ToolTipService.ToolTip="Show tool information"
                                        AutomationProperties.Name="Show tool information">
                                        <TextBlock
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Text="i" />
                                    </Button>
                                    <Button
                                        Grid.Column="2"
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        Click="PinButton_Click"
                                        ToolTipService.ToolTip="Pin this card to the desktop"
                                        AutomationProperties.Name="Pin this card to the desktop">
                                        <SymbolIcon Symbol="Pin" />
                                    </Button>
                                </Grid>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Description}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border
                            MinHeight="180"
                            Padding="20"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{x:Bind local:CategoryPage.ConverterVisibility(IsConverter), Mode=OneWay}">
                            <StackPanel Spacing="14">
                                <Grid RowSpacing="4" ColumnSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Title}"
                                        TextWrapping="Wrap" />
                                    <Button
                                        Grid.Column="1"
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        Click="InfoButton_Click"
                                        ToolTipService.ToolTip="Show tool information"
                                        AutomationProperties.Name="Show tool information">
                                        <TextBlock
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Text="i" />
                                    </Button>
                                    <Button
                                        Grid.Column="2"
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        Click="PinButton_Click"
                                        ToolTipService.ToolTip="Pin this card to the desktop"
                                        AutomationProperties.Name="Pin this card to the desktop">
                                        <SymbolIcon Symbol="Pin" />
                                    </Button>
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.ColumnSpan="3"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Description}"
                                        TextWrapping="Wrap" />
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind SourceFormat, Mode=OneWay}" />
                                    <Button
                                        Grid.Column="1"
                                        Width="36"
                                        Height="36"
                                        Click="ExchangeFormats_Click"
                                        Padding="0"
                                        ToolTipService.ToolTip="Exchange formats"
                                        AutomationProperties.Name="Exchange formats">
                                        <SymbolIcon Symbol="Sync" />
                                    </Button>
                                    <TextBlock
                                        Grid.Column="2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind TargetFormat, Mode=OneWay}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border
                            Padding="20"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Tapped="KubernetesCard_Tapped"
                            Visibility="{x:Bind local:CategoryPage.KubernetesVisibility(IsKubernetesCalculator), Mode=OneWay}">
                            <StackPanel Spacing="14">
                                <Grid RowSpacing="4" ColumnSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Title}"
                                        TextWrapping="Wrap" />
                                    <Button
                                        Grid.Column="1"
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        Click="PinButton_Click"
                                        ToolTipService.ToolTip="Pin this card to the desktop"
                                        AutomationProperties.Name="Pin this card to the desktop">
                                        <SymbolIcon Symbol="Pin" />
                                    </Button>
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Description}"
                                        TextWrapping="Wrap" />
                                </Grid>
                                <ItemsControl ItemsSource="{x:Bind SubCards}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid MaximumRowsOrColumns="2" Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:ToolSubCard">
                                            <Border
                                                Width="300"
                                                MinHeight="100"
                                                Margin="0,0,10,10"
                                                Padding="12"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                                <StackPanel Spacing="6">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Text="{x:Bind Title}" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind Description}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Button
                            Width="32"
                            Height="32"
                            Margin="0,8,8,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Click="InfoButton_Click"
                            Padding="0"
                            ToolTipService.ToolTip="Show tool information"
                            AutomationProperties.Name="Show tool information"
                            Visibility="{x:Bind local:CategoryPage.KubernetesVisibility(IsKubernetesCalculator), Mode=OneWay}">
                            <SymbolIcon Symbol="Help" />
                        </Button>
                        <Button
                            Width="32"
                            Height="32"
                            Margin="0,8,8,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Click="InfoButton_Click"
                            Padding="0"
                            ToolTipService.ToolTip="Show tool information"
                            AutomationProperties.Name="Show tool information"
                            Visibility="{x:Bind local:CategoryPage.ConverterVisibility(IsConverter), Mode=OneWay}">
                            <SymbolIcon Symbol="Help" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock
            x:Name="EmptyState"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="No tools available in this category yet."
            Visibility="Collapsed" />
    </Grid>
</Page>
