<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Tools365.Health.OvulationPeriodTracker.OvulationPeriodTrackerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Ovulation | Period tracker">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid Padding="24" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="Ovulation &amp; period tracker" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Estimate cycle dates from the first day of your last period."
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border
                Grid.Row="1"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid ColumnSpacing="16" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.ColumnSpan="2" Spacing="6">
                        <TextBlock Text="First day of last period" />
                        <CalendarDatePicker
                            x:Name="LastPeriodDatePicker"
                            PlaceholderText="Choose a date" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Spacing="6">
                        <TextBlock Text="Average cycle length (days)" />
                        <NumberBox
                            x:Name="CycleLengthBox"
                            Minimum="21"
                            Maximum="45"
                            Value="28"
                            SpinButtonPlacementMode="Inline" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                        <TextBlock Text="Period length (days)" />
                        <NumberBox
                            x:Name="PeriodLengthBox"
                            Minimum="1"
                            Maximum="10"
                            Value="5"
                            SpinButtonPlacementMode="Inline" />
                    </StackPanel>
                </Grid>
            </Border>

            <Button
                Grid.Row="2"
                HorizontalAlignment="Left"
                Click="CalculateButton_Click"
                Content="Estimate cycle dates"
                Style="{StaticResource AccentButtonStyle}" />

            <StackPanel Grid.Row="3" Spacing="12">
                <InfoBar
                    x:Name="ValidationBar"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Warning" />

                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="12">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Estimated dates" />
                        <Grid ColumnSpacing="16" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Next period" />
                            <TextBlock
                                x:Name="NextPeriodText"
                                Grid.Column="1"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Right"
                                Text="-" />

                            <TextBlock Grid.Row="1" Text="Estimated period ends" />
                            <TextBlock
                                x:Name="PeriodEndText"
                                Grid.Row="1"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                Text="-" />

                            <TextBlock Grid.Row="2" Text="Estimated ovulation" />
                            <TextBlock
                                x:Name="OvulationText"
                                Grid.Row="2"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                Text="-" />

                            <TextBlock Grid.Row="3" Text="Estimated fertile window" />
                            <TextBlock
                                x:Name="FertileWindowText"
                                Grid.Row="3"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                Text="-" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock
                Grid.Row="4"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Estimates assume a regular cycle and ovulation about 14 days before the next period. Actual cycles and ovulation can vary. This tool cannot confirm ovulation, prevent pregnancy, or replace medical advice; do not use it as contraception. If your cycles are irregular or you have concerns, consult a healthcare professional."
                TextWrapping="Wrap" />
        </Grid>
    </ScrollViewer>
</Window>
