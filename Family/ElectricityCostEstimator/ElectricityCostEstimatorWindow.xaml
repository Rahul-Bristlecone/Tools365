<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Tools365.Family.ElectricityCostEstimator.ElectricityCostEstimatorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Electricity cost estimator">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto"
        ZoomMode="Disabled">
        <Grid Padding="16" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock
                    FontSize="24"
                    FontWeight="SemiBold"
                    Text="Electricity cost estimator" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Estimate monthly consumption and electricity costs."
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,4,0,0" Spacing="12">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Region" />
                        <ComboBox x:Name="RegionComboBox" Width="180" DisplayMemberPath="Name" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="Sanctioned load (kW)" />
                        <NumberBox
                            x:Name="SanctionedLoadBox"
                            Minimum="0"
                            PlaceholderText="e.g. 3"
                            SpinButtonPlacementMode="Inline" />
                    </StackPanel>
                </Grid>

                <TextBlock FontSize="12" FontWeight="SemiBold" Text="Appliances" />

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Appliance" />
                    <TextBlock Grid.Column="1" Text="Count" />
                    <TextBlock Grid.Column="2" Text="Watts" />
                    <TextBlock Grid.Column="3" Text="Hours/day" />
                </Grid>
                <ItemsControl x:Name="ApplianceEntriesControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    SelectedIndex="{Binding ApplianceIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="Air conditioner" />
                                    <ComboBoxItem Content="Ceiling fan" />
                                    <ComboBoxItem Content="Refrigerator" />
                                    <ComboBoxItem Content="Television" />
                                    <ComboBoxItem Content="Washing machine" />
                                    <ComboBoxItem Content="Water heater" />
                                    <ComboBoxItem Content="Water pump" />
                                    <ComboBoxItem Content="Other appliance" />
                                </ComboBox>
                                <NumberBox
                                    Grid.Column="1"
                                    Width="80"
                                    Minimum="1"
                                    Value="{Binding Quantity, Mode=TwoWay}"
                                    SpinButtonPlacementMode="Hidden"
                                    ValueChanged="ApplianceInput_ValueChanged" />
                                <NumberBox
                                    Grid.Column="3"
                                    Minimum="0"
                                    PlaceholderText="e.g. 75"
                                    Value="{Binding Watts, Mode=TwoWay}"
                                    SpinButtonPlacementMode="Hidden"
                                    ValueChanged="ApplianceInput_ValueChanged" />
                                <NumberBox
                                    Grid.Column="4"
                                    Minimum="0"
                                    Maximum="24"
                                    PlaceholderText="e.g. 8"
                                    Value="{Binding HoursPerDay, Mode=TwoWay}"
                                    SpinButtonPlacementMode="Hidden"
                                    ValueChanged="ApplianceInput_ValueChanged" />
                                <Button
                                    Grid.Column="6"
                                    VerticalAlignment="Center"
                                    Click="RemoveApplianceButton_Click">
                                    <SymbolIcon Symbol="Delete" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button
                    x:Name="AddApplianceButton"
                    HorizontalAlignment="Left"
                    Click="AddApplianceButton_Click"
                    Content="Add appliance"
                    IsEnabled="False" />
            </StackPanel>

            <Button
                Grid.Row="2"
                Background="#286076"
                Foreground="White"
                HorizontalAlignment="Left"
                Click="CalculateButton_Click"
                Content="Calculate estimate" />

            <InfoBar
                x:Name="ValidationBar"
                Grid.Row="3"
                IsClosable="False"
                IsOpen="False"
                Severity="Warning" />

            <Border
                Grid.Row="4"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Translation="0,0,32">
                <StackPanel Spacing="10">
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Monthly estimate" />
                <Grid ColumnSpacing="16" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Units consumed" />
                    <TextBlock x:Name="UnitsConsumedText" Grid.Column="1" HorizontalAlignment="Right" Text="-" />
                    <TextBlock Grid.Row="1" Text="Energy charges" />
                    <TextBlock x:Name="EnergyChargesText" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" Text="-" />
                    <TextBlock Grid.Row="2" Text="Fixed charge" />
                    <TextBlock x:Name="FixedChargesText" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" Text="-" />
                    <TextBlock x:Name="PpacLabel" Grid.Row="3" Text="PPAC" />
                    <TextBlock x:Name="PpacText" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right" Text="-" />
                    <TextBlock x:Name="ElectricityDutyLabel" Grid.Row="4" Text="Electricity duty" />
                    <TextBlock x:Name="ElectricityDutyText" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Right" Text="-" />
                    <TextBlock Grid.Row="5" Text="Gross bill" />
                    <TextBlock x:Name="GrossBillText" Grid.Row="5" Grid.Column="1" HorizontalAlignment="Right" Text="-" />
                    <TextBlock Grid.Row="6" Text="Subsidy" />
                    <TextBlock x:Name="SubsidyText" Grid.Row="6" Grid.Column="1" HorizontalAlignment="Right" Text="-" />
                    <TextBlock Grid.Row="7" FontWeight="SemiBold" Text="Final bill" />
                    <TextBlock x:Name="FinalBillText" Grid.Row="7" Grid.Column="1" HorizontalAlignment="Right" FontWeight="SemiBold" Text="-" />
                </Grid>
                </StackPanel>
            </Border>

            <InfoBar
                x:Name="SubsidyBar"
                Grid.Row="5"
                IsClosable="False"
                IsOpen="False" />
        </Grid>
    </ScrollViewer>
</Window>