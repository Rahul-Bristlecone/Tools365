<?xml version="1.0" encoding="utf-8" ?>
<Window x:Class="Tools365.Family.TripPackingChecklist.TripPackingChecklistWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Tools365.Family.TripPackingChecklist"
    Title="Trip Packing checklist"  >
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto"
        ZoomMode="Disabled" >
        <Grid Padding="16" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="Trip Packing checklist" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Organise essentials for your next journey and track what is already packed."
                    TextWrapping="Wrap" />
            </StackPanel>

            <Grid Row="1" ColumnSpacing="16" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="12">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Trip profile" />

                        <StackPanel Spacing="6">
                            <TextBlock Text="Trip type" />
                            <ComboBox
                                x:Name="TripTypeComboBox"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="TripTypeComboBox_SelectionChanged" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Trip length" />
                            <ComboBox
                                x:Name="TripLengthComboBox"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="TripLengthComboBox_SelectionChanged" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="1"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Packing status" />

                        <Grid Row="1" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Packed" />
                                <TextBlock x:Name="PackedItemsText" FontSize="22" FontWeight="SemiBold" Text="0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Remaining" />
                                <TextBlock x:Name="RemainingItemsText" FontSize="22" FontWeight="SemiBold" Text="0" />
                            </StackPanel>
                        </Grid>

                        <Grid Row="2" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Total items" />
                                <TextBlock x:Name="TotalItemsText" FontSize="18" FontWeight="SemiBold" Text="0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Essentials" />
                                <TextBlock x:Name="EssentialItemsText" FontSize="18" FontWeight="SemiBold" Text="0" />
                            </StackPanel>
                        </Grid>

                        <ProgressBar
                            x:Name="PackingProgressBar"
                            Grid.Row="3"
                            Maximum="100"
                            Value="0" />

                        <TextBlock
                            x:Name="TripReadinessText"
                            Grid.Row="4"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            FontWeight="SemiBold"
                            Text="Packing not started" />
                    </Grid>
                </Border>
            </Grid>

            <Border
                Grid.Row="2"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            x:Name="ItemNameTextBox"
                            PlaceholderText="Add a custom item"
                            Text="" />

                        <ComboBox
                            x:Name="CategoryComboBox"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            SelectedIndex="0" />

                        <Button
                            Grid.Column="2"
                            Click="AddItemButton_Click"
                            Content="Add item" />

                        <Button
                            Grid.Column="3"
                            Click="ResetChecklistButton_Click"
                            Content="Reset" />
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
                        <Button Click="MarkAllPackedButton_Click" Content="Mark all packed" />
                        <Button Click="ClearPackedButton_Click" Content="Clear packed" />
                    </StackPanel>

                    <TextBlock
                        x:Name="StatusTextBlock"
                        Grid.Row="2"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Text=""
                        TextWrapping="Wrap" />

                    <ListView
                        x:Name="ChecklistListView"
                        Grid.Row="3"
                        Margin="0,4,0,0"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:PackingItem">
                                <Border Padding="6" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox
                                            IsChecked="{Binding IsPacked, Mode=TwoWay}"
                                            Checked="ChecklistItem_Checked"
                                            Unchecked="ChecklistItem_Unchecked" />

                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Opacity="{Binding PackedOpacity}"
                                                Text="{Binding Name}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Category}" />
                                        </StackPanel>

                                        <Border
                                            Grid.Column="2"
                                            Padding="6,2"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="8"
                                            Visibility="{Binding EssentialVisibility}">
                                            <TextBlock
                                                FontSize="10"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Text="ESSENTIAL" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
