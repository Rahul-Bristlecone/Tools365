<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Tools365.Family.ApplianceWarrantyTracker.ApplianceWarrantyTrackerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Appliance Warranty Tracker">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid Padding="24" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock FontSize="26" FontWeight="SemiBold" Text="Appliance Warranty Tracker" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Keep appliance purchase details and see which warranties are active or nearing expiry."
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border
                Grid.Row="1"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Add an appliance" />
                    <Grid ColumnSpacing="12" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="5">
                            <TextBlock Text="Appliance name *" />
                            <TextBox
                                x:Name="ApplianceNameBox"
                                PlaceholderText="e.g. Refrigerator"
                                AutomationProperties.Name="Appliance name" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5">
                            <TextBlock Text="Brand" />
                            <TextBox
                                x:Name="BrandBox"
                                PlaceholderText="e.g. Example"
                                AutomationProperties.Name="Appliance brand" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Spacing="5">
                            <TextBlock Text="Model or serial number" />
                            <TextBox
                                x:Name="ModelBox"
                                PlaceholderText="Optional"
                                AutomationProperties.Name="Model or serial number" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="5">
                            <TextBlock Text="Purchase date *" />
                            <CalendarDatePicker
                                x:Name="PurchaseDatePicker"
                                PlaceholderText="Choose purchase date"
                                AutomationProperties.Name="Purchase date" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Spacing="5">
                            <TextBlock Text="Warranty duration (months) *" />
                            <NumberBox
                                x:Name="WarrantyMonthsBox"
                                Value="12"
                                Minimum="1"
                                Maximum="600"
                                SpinButtonPlacementMode="Compact"
                                AutomationProperties.Name="Warranty duration in months" />
                        </StackPanel>
                        <Button
                            x:Name="AddApplianceButton"
                            Grid.Row="2"
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Click="AddApplianceButton_Click"
                            Content="Add appliance" />
                    </Grid>
                </StackPanel>
            </Border>

            <InfoBar
                x:Name="StatusBar"
                Grid.Row="2"
                IsClosable="False"
                IsOpen="False" />

            <StackPanel Grid.Row="3" Spacing="10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="SummaryText"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="No appliances tracked yet."
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="ClearAllButton"
                        Grid.Column="1"
                        Click="ClearAllButton_Click"
                        Content="Clear all"
                        IsEnabled="False" />
                </Grid>
                <TextBlock
                    x:Name="EmptyState"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Add an appliance above to start tracking its warranty."
                    TextWrapping="Wrap" />
                <ItemsControl x:Name="AppliancesList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="14"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            FontSize="17"
                                            FontWeight="SemiBold"
                                            Text="{Binding DisplayName}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Details}"
                                            TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding PurchaseDetails}" />
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Status}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Content="Remove"
                                        Tag="{Binding Id}"
                                        Click="RemoveApplianceButton_Click" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
