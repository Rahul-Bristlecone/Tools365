<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Tools365.Utility.AgeCalculator.AgeCalculatorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Age calculator">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Age calculator" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Calculate your age and see how long until your next birthday."
                TextWrapping="Wrap" />
        </StackPanel>

        <CalendarDatePicker
            x:Name="DateOfBirthPicker"
            Grid.Row="1"
            Header="Date of birth"
            PlaceholderText="Choose your date of birth" />

        <Button
            Grid.Row="2"
            HorizontalAlignment="Right"
            Click="CalculateButton_Click"
            Content="Calculate age" />

        <InfoBar
            x:Name="ValidationBar"
            Grid.Row="3"
            IsClosable="False"
            IsOpen="False"
            Severity="Warning" />

        <Border
            x:Name="ResultPanel"
            Grid.Row="4"
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Visibility="Collapsed">
            <StackPanel Spacing="10">
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Your age" />
                <TextBlock x:Name="AgeText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock
                    x:Name="NextBirthdayText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="DaysLivedText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>