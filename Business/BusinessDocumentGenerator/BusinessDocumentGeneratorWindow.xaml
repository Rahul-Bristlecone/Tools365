<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Tools365.Business.BusinessDocumentGenerator.BusinessDocumentGeneratorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Business document maker">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <ScrollViewer>
        <Grid Padding="28" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock
                    x:Name="TitleText"
                    FontSize="26"
                    FontWeight="SemiBold"
                    Text="Business document maker" />
                <TextBlock
                    x:Name="SubtitleText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Prepare a customer document with line items and totals."
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border
                Grid.Row="1"
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="NumberLabel" Text="Document number" />
                            <TextBox
                                x:Name="DocumentNumberBox"
                                PlaceholderText="e.g. INV-2026-001"
                                AutomationProperties.Name="Document number" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Your business name" />
                            <TextBox
                                x:Name="SellerBox"
                                PlaceholderText="Business or seller name"
                                AutomationProperties.Name="Your business name" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Customer" />
                            <TextBox
                                x:Name="CustomerBox"
                                PlaceholderText="Customer or company"
                                AutomationProperties.Name="Customer name" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Currency" />
                            <ComboBox
                                x:Name="CurrencyComboBox"
                                HorizontalAlignment="Stretch"
                                SelectedIndex="0"
                                AutomationProperties.Name="Document currency">
                                <ComboBoxItem Content="INR" />
                                <ComboBoxItem Content="USD" />
                                <ComboBoxItem Content="EUR" />
                                <ComboBoxItem Content="GBP" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="DocumentDateLabel" Text="Document date" />
                            <CalendarDatePicker
                                x:Name="DocumentDatePicker"
                                PlaceholderText="Choose document date"
                                AutomationProperties.Name="Document date" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock x:Name="EndDateLabel" Text="Due or valid-until date (optional)" />
                            <CalendarDatePicker
                                x:Name="EndDatePicker"
                                PlaceholderText="Choose date"
                                AutomationProperties.Name="Due or valid-until date" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Terms and notes (optional)" />
                        <TextBox
                            x:Name="TermsBox"
                            AcceptsReturn="True"
                            MinHeight="72"
                            PlaceholderText="Payment terms, delivery notes, or other details"
                            TextWrapping="Wrap"
                            AutomationProperties.Name="Terms and notes" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Grid.Row="2"
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="Line items" />
                        <Button
                            Grid.Column="1"
                            Click="AddLineButton_Click"
                            Content="Add item"
                            AutomationProperties.Name="Add document line item" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontWeight="SemiBold" Text="Description" />
                        <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Quantity" />
                        <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Unit price" />
                    </Grid>
                    <StackPanel
                        x:Name="LineItemsPanel"
                        Spacing="8" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="3" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <TextBlock Text="Tax rate (%)" />
                    <NumberBox
                        x:Name="TaxRateBox"
                        Value="0"
                        Minimum="0"
                        Maximum="100"
                        SpinButtonPlacementMode="Compact"
                        AutomationProperties.Name="Tax rate percentage" />
                </StackPanel>
                <Border
                    Grid.Column="1"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="4">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="TOTAL" />
                        <TextBlock
                            x:Name="TotalText"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Text="—" />
                    </StackPanel>
                </Border>
            </Grid>

            <InfoBar
                x:Name="ValidationBar"
                Grid.Row="4"
                IsClosable="False"
                IsOpen="False"
                Severity="Warning" />

            <StackPanel Grid.Row="5" Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="GenerateButton"
                        Click="GenerateButton_Click"
                        Content="Generate document"
                        AutomationProperties.Name="Generate business document" />
                    <Button
                        x:Name="CopyButton"
                        Click="CopyButton_Click"
                        Content="Copy document"
                        IsEnabled="False"
                        AutomationProperties.Name="Copy generated document" />
                </StackPanel>
                <TextBox
                    x:Name="OutputBox"
                    AcceptsReturn="True"
                    FontFamily="Cascadia Mono"
                    IsReadOnly="True"
                    IsSpellCheckEnabled="False"
                    MinHeight="220"
                    PlaceholderText="Generated document will appear here..."
                    TextWrapping="Wrap"
                    AutomationProperties.Name="Generated document" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
