<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Tools365.Business.PurchaseOrderGenerator.PurchaseOrderGeneratorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PO generator">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <ScrollViewer>
        <Grid Padding="28" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock FontSize="26" FontWeight="SemiBold" Text="Purchase order generator" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Enter order and supplier details, add items, then generate a purchase order summary."
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border
                Grid.Row="1"
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="PO number" />
                            <TextBox
                                x:Name="PurchaseOrderNumberBox"
                                PlaceholderText="e.g. PO-2026-001"
                                AutomationProperties.Name="Purchase order number" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Supplier" />
                            <TextBox
                                x:Name="SupplierBox"
                                PlaceholderText="Supplier or vendor name"
                                AutomationProperties.Name="Supplier name" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Buyer (optional)" />
                            <TextBox
                                x:Name="BuyerBox"
                                PlaceholderText="Buyer or requesting department"
                                AutomationProperties.Name="Buyer name" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Currency" />
                            <ComboBox
                                x:Name="CurrencyComboBox"
                                HorizontalAlignment="Stretch"
                                SelectedIndex="0"
                                AutomationProperties.Name="Purchase order currency">
                                <ComboBoxItem Content="INR" />
                                <ComboBoxItem Content="USD" />
                                <ComboBoxItem Content="EUR" />
                                <ComboBoxItem Content="GBP" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Order date" />
                            <CalendarDatePicker
                                x:Name="OrderDatePicker"
                                PlaceholderText="Choose order date"
                                AutomationProperties.Name="Order date" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Requested delivery date (optional)" />
                            <CalendarDatePicker
                                x:Name="DeliveryDatePicker"
                                PlaceholderText="Choose delivery date"
                                AutomationProperties.Name="Requested delivery date" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border
                Grid.Row="2"
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="Line items" />
                        <Button
                            Grid.Column="1"
                            Click="AddLineButton_Click"
                            Content="Add item"
                            AutomationProperties.Name="Add purchase order line item" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontWeight="SemiBold" Text="Description" />
                        <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Quantity" />
                        <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Unit price" />
                    </Grid>
                    <StackPanel
                        x:Name="LineItemsPanel"
                        Spacing="8" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="3" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <TextBlock Text="Tax rate (%)" />
                    <NumberBox
                        x:Name="TaxRateBox"
                        Value="0"
                        Minimum="0"
                        Maximum="100"
                        SpinButtonPlacementMode="Compact"
                        AutomationProperties.Name="Tax rate percentage" />
                </StackPanel>
                <Border
                    Grid.Column="1"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="4">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="ESTIMATED TOTAL" />
                        <TextBlock
                            x:Name="TotalText"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Text="—" />
                    </StackPanel>
                </Border>
            </Grid>

            <InfoBar
                x:Name="ValidationBar"
                Grid.Row="4"
                IsClosable="False"
                IsOpen="False"
                Severity="Warning" />

            <StackPanel Grid.Row="5" Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        Click="GenerateButton_Click"
                        Content="Generate purchase order"
                        AutomationProperties.Name="Generate purchase order" />
                    <Button
                        x:Name="CopyButton"
                        Click="CopyButton_Click"
                        Content="Copy purchase order"
                        IsEnabled="False"
                        AutomationProperties.Name="Copy generated purchase order" />
                </StackPanel>
                <TextBox
                    x:Name="OutputBox"
                    AcceptsReturn="True"
                    FontFamily="Cascadia Mono"
                    IsReadOnly="True"
                    IsSpellCheckEnabled="False"
                    MinHeight="220"
                    PlaceholderText="Generated purchase order will appear here..."
                    TextWrapping="Wrap"
                    AutomationProperties.Name="Generated purchase order" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
