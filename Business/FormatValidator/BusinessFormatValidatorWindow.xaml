<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Tools365.Business.FormatValidator.BusinessFormatValidatorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="GST, PAN and Aadhaar format validator">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <ScrollViewer>
        <Grid Padding="28" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock FontSize="26" FontWeight="SemiBold" Text="GST, PAN and Aadhaar format validator" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Check identifier structure locally on this device. Values are not sent or saved."
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border
                Grid.Row="1"
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="6">
                        <TextBlock Text="GSTIN" />
                        <TextBox
                            x:Name="GstinBox"
                            MaxLength="15"
                            PlaceholderText="15-character GSTIN"
                            AutomationProperties.Name="GSTIN to validate" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="PAN" />
                        <TextBox
                            x:Name="PanBox"
                            MaxLength="10"
                            PlaceholderText="10-character PAN"
                            AutomationProperties.Name="PAN to validate" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Aadhaar number" />
                        <PasswordBox
                            x:Name="AadhaarBox"
                            MaxLength="14"
                            PlaceholderText="12 digits"
                            PasswordRevealMode="Peek"
                            AutomationProperties.Name="Aadhaar number to validate" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <InfoBar
                x:Name="NoticeBar"
                Grid.Row="2"
                IsClosable="False"
                IsOpen="True"
                Message="This checks format only. It does not verify identity, issue status, or government records."
                Severity="Informational"
                Title="Format-only check" />

            <StackPanel Grid.Row="3" Spacing="12">
                <Button
                    HorizontalAlignment="Left"
                    Click="ValidateButton_Click"
                    Content="Check formats"
                    AutomationProperties.Name="Check GSTIN PAN and Aadhaar formats" />
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="10">
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="Results" />
                        <TextBlock
                            x:Name="GstinResultText"
                            AutomationProperties.LiveSetting="Polite"
                            Text="GSTIN: Not checked" />
                        <TextBlock
                            x:Name="PanResultText"
                            AutomationProperties.LiveSetting="Polite"
                            Text="PAN: Not checked" />
                        <TextBlock
                            x:Name="AadhaarResultText"
                            AutomationProperties.LiveSetting="Polite"
                            Text="Aadhaar: Not checked" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
