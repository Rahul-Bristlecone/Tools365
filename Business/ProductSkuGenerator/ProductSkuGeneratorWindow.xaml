<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Tools365.Business.ProductSkuGenerator.ProductSkuGeneratorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Product SKU generator">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <ScrollViewer>
        <Grid Padding="28" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock FontSize="26" FontWeight="SemiBold" Text="Product SKU generator" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Build consistent SKUs from product codes and a unique numbered sequence."
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border
                Grid.Row="1"
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Prefix (optional)" />
                            <TextBox
                                x:Name="PrefixBox"
                                PlaceholderText="e.g. SHOP"
                                AutomationProperties.Name="Optional SKU prefix" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Category code (optional)" />
                            <TextBox
                                x:Name="CategoryCodeBox"
                                PlaceholderText="e.g. HOME"
                                AutomationProperties.Name="Optional category code" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Product code" />
                            <TextBox
                                x:Name="ProductCodeBox"
                                PlaceholderText="e.g. LAMP"
                                AutomationProperties.Name="Product code" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Separator" />
                            <ComboBox
                                x:Name="SeparatorComboBox"
                                HorizontalAlignment="Stretch"
                                SelectedIndex="0"
                                AutomationProperties.Name="SKU component separator">
                                <ComboBoxItem Content="Hyphen (-)" />
                                <ComboBoxItem Content="Underscore (_)" />
                                <ComboBoxItem Content="None" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Start sequence at" />
                            <NumberBox
                                x:Name="StartingNumberBox"
                                Value="1"
                                Minimum="0"
                                Maximum="999999999999"
                                SpinButtonPlacementMode="Compact"
                                AutomationProperties.Name="Starting SKU sequence number" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Quantity" />
                            <NumberBox
                                x:Name="QuantityBox"
                                Value="10"
                                Minimum="1"
                                Maximum="1000"
                                SpinButtonPlacementMode="Compact"
                                AutomationProperties.Name="Number of SKUs to generate" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="6">
                            <TextBlock Text="Sequence digits" />
                            <NumberBox
                                x:Name="DigitsBox"
                                Value="5"
                                Minimum="1"
                                Maximum="12"
                                SpinButtonPlacementMode="Compact"
                                AutomationProperties.Name="Minimum SKU sequence digits" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <InfoBar
                x:Name="ValidationBar"
                Grid.Row="2"
                IsClosable="False"
                IsOpen="False"
                Severity="Warning" />

            <Border
                Grid.Row="3"
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="8">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="PRODUCT SKUs" />
                    <TextBox
                        x:Name="SkusBox"
                        AcceptsReturn="True"
                        FontFamily="Cascadia Mono"
                        IsReadOnly="True"
                        IsSpellCheckEnabled="False"
                        MinHeight="180"
                        PlaceholderText="Generated product SKUs will appear here..."
                        TextWrapping="NoWrap"
                        AutomationProperties.Name="Generated product SKUs" />
                </StackPanel>
            </Border>

            <StackPanel
                Grid.Row="4"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Click="GenerateButton_Click"
                    Content="Generate"
                    AutomationProperties.Name="Generate product SKUs" />
                <Button
                    x:Name="CopyButton"
                    Click="CopyButton_Click"
                    Content="Copy SKUs"
                    IsEnabled="False"
                    AutomationProperties.Name="Copy product SKUs" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
