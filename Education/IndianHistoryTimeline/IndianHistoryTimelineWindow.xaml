<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Tools365.Education.IndianHistoryTimeline.IndianHistoryTimelineWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Tools365.Education.IndianHistoryTimeline"
    Title="Indian history timeline">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Indian history timeline" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Explore selected milestones from the ancient period to modern India."
                TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox
                x:Name="SearchBox"
                PlaceholderText="Search events, people, or topics"
                TextChanged="SearchBox_TextChanged"
                AutomationProperties.Name="Search history timeline" />
            <ComboBox
                x:Name="PeriodComboBox"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                SelectionChanged="PeriodComboBox_SelectionChanged"
                AutomationProperties.Name="Filter by historical period" />
        </Grid>

        <TextBlock
            x:Name="ResultCountText"
            Grid.Row="2"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <Grid Grid.Row="3">
            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl
                    x:Name="EventsList"
                    ItemsSource="{x:Bind VisibleEvents, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:HistoryEvent">
                            <Grid Margin="0,0,0,12" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Width="2"
                                    HorizontalAlignment="Center"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}" />
                                <Ellipse
                                    Width="12"
                                    Height="12"
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="0,8,0,0"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind DateLabel}"
                                    TextWrapping="Wrap" />
                                <Border
                                    Grid.Column="2"
                                    Padding="14"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <StackPanel Spacing="6">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            FontSize="12"
                                            Text="{x:Bind Period}" />
                                        <TextBlock
                                            FontSize="17"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Title}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Description}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock
                x:Name="EmptyStateText"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="No events match your search."
                IsHitTestVisible="False" />
        </Grid>
    </Grid>
</Window>
